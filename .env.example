# Copy to `.env` and adjust. `docker compose` passes these directly instead.
#
#   cp .env.example .env

# ----------------------------------------------------------------- required

# With `docker compose up -d db`, the database is reachable on localhost:5432.
DATABASE_URL=postgres://alkyne:alkyne@localhost:5432/alkyne

# Signing key for HS256 access tokens. Must be at least 32 bytes; the app
# refuses to start with anything shorter. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=local-development-only-secret-change-me

# ----------------------------------------------------------------- optional

# Address the HTTP server binds. Use 0.0.0.0:8080 inside a container.
BIND_ADDRESS=127.0.0.1:8080

# Access-token lifetime, seconds.
JWT_TTL_SECONDS=3600

# Two-factor code lifetime, seconds. The assignment requires 5 minutes.
TWO_FACTOR_CODE_TTL_SECONDS=300

# Wrong-code attempts allowed per login challenge before it locks.
TWO_FACTOR_MAX_ATTEMPTS=5

# Lifetime of a cached `view-my-tasks` payload, seconds. Kept generous so the
# cache is still warm when the flow is walked through by hand.
CACHE_TTL_SECONDS=300

# Serves GET /dev/email-logs*, which reveal two-factor codes.
# Must be false anywhere that is not a local development machine.
ENABLE_DEV_ENDPOINTS=true

# Accounts created by POST /seed/users.
SEED_ADMIN_FULL_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_STAFF_FULL_NAME="James Bond"
SEED_STAFF_EMAIL=jamesbond@example.com
SEED_STAFF_PASSWORD=BondPass123!

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,sqlx::query=warn
